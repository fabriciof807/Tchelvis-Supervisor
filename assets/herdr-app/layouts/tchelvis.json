{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "tchelvis-pill",
      "type": "block",
      "size": {
        "px": 36
      },
      "window_drag": true,
      "content": {
        "mod": "tchelvis",
        "props": {
          "role": "pill"
        }
      }
    },
    {
      "id": "workspace-row",
      "type": "row",
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
      "type": "column",
      "size": {
        "px": 296
      },
      "min": 220,
      "max": 480,
      "background": "chrome",
      "resizable": true,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 0.85
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "tchelvis-fleet",
              "type": "block",
              "size": {
                "weight": 1.35
              },
              "min": 140,
              "content": {
                "mod": "tchelvis",
                "props": {
                  "role": "fleet"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "tchelvis-home",
              "type": "block",
              "hidden": true,
              "size": {
                "px": 430
              },
              "min": 320,
              "max": 760,
              "content": {
                "mod": "tchelvis",
                "props": {
                  "role": "home"
                }
              }
            },
            {
              "id": "tchelvis-inspector",
              "type": "block",
              "size": {
                "px": 420
              },
              "min": 310,
              "max": 680,
              "resizable": true,
              "content": {
                "mod": "tchelvis",
                "props": {
                  "role": "inspector"
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "tchelvis",
            "props": {
              "role": "status"
            }
          }
        }
      ]
    }
      ]
    }
  ]
}
